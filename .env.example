# Copy to .env and fill in from the cheat sheet.
VITE_WRITE_URL=https://w.katta.example.org
VITE_READ_URLS=https://a.katta.example.org,https://b.katta.example.org
VITE_BATCH_ID=
# Optional: whose archive the app shows. npm run deploy sets this for you.
VITE_ARCHIVE_OWNER=
# L3: adopt archives through node B (values on the cheat sheet).
VITE_ADOPT_URL=
VITE_ADOPT_BATCH_ID=
# npm run deploy / seed: your keeper key, copied from the app. Never commit .env.
KEEPER_KEY=
